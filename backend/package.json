{
  "name": "brisas-marinas-backend",
  "version": "1.0.0",
  "description": "Backend de la plataforma web del Restaurante Brisas Marinas - Sistema de gestión de ventas, inventario y reportes",
  "main": "server.js",
  "scripts": {
    "start": "npm run db:reset && node server.js",
    "dev": "nodemon server.js",
    "db:create": "node database/init-db.js",
    "db:schema": "node database/run-sql.js schema.sql",
    "db:seed": "node database/run-sql.js seed.sql",
    "db:seed-users": "node database/seed-users.js",
    "db:reset": "npm run db:schema && npm run db:seed && npm run db:seed-users"
  },
  "keywords": [
    "restaurant",
    "pos",
    "nodejs",
    "postgresql",
    "brisas-marinas"
  ],
  "author": "María Alejandra Pineda Godin & Shaira Jimena Julio Marzán",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
